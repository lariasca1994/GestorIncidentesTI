@page "{id:int}"
@model GestorIncidentesTI.Pages.Incidentes.DetalleModel
@using GestorIncidentesTI.Models
@using GestorIncidentesTI.Services
@{
    ViewData["Title"] = Model.Incidente.Titulo;
    var inc = Model.Incidente;
}

<p><a asp-page="./Index">&larr; Volver a incidentes</a></p>

<h1>@Model.Incidente.Titulo</h1>

<p>
    <span class="badge badge-@inc.Prioridad.ToString().ToLowerInvariant()">@AvisosIncidente.Prioridad(inc.Prioridad)</span>
    <span class="badge badge-@inc.Estado.ToString().ToLowerInvariant()">@AvisosIncidente.Estado(inc.Estado)</span>
</p>

<p><strong>Proyecto:</strong> @inc.Proyecto?.Nombre</p>
<p><strong>Categoría:</strong> @inc.Categoria@(inc.Subcategoria is null ? "" : $" › {inc.Subcategoria}")</p>
@if (inc.Impacto is not null && inc.Urgencia is not null)
{
    <p><strong>Impacto:</strong> @MatrizPrioridad.Impacto(inc.Impacto.Value) · <strong>Urgencia:</strong> @MatrizPrioridad.Urgencia(inc.Urgencia.Value)</p>
}
<p><strong>Solicitante:</strong> @inc.SolicitanteNombre</p>
<p><strong>Descripción:</strong> @inc.Descripcion</p>
<p><strong>Creado:</strong> @inc.FechaCreacion.ToLocalTime().ToString("g")</p>
@if (inc.FechaLimiteRespuesta is not null)
{
    <p>
        <strong>Primera respuesta:</strong>
        @if (inc.FechaPrimeraRespuesta is not null)
        {
            @inc.FechaPrimeraRespuesta.Value.ToLocalTime().ToString("g")
        }
        else
        {
            <span>pendiente, límite @inc.FechaLimiteRespuesta.Value.ToLocalTime().ToString("g")</span>
        }
        <span class="badge badge-@(inc.RespuestaIncumplida ? "vencido" : "ok")">@(inc.RespuestaIncumplida ? "Fuera de tiempo" : "A tiempo")</span>
    </p>
}
<p><strong>Límite SLA:</strong> @(inc.FechaLimiteSla?.ToLocalTime().ToString("g") ?? "Sin SLA") <small>(@CalendarioSla.Descripcion(inc.Prioridad))</small></p>
@if (inc.Estado == EstadoIncidente.EnEspera)
{
    <p><em>En espera del solicitante: el SLA está detenido y la fecha límite se corre al reanudar.</em></p>
}

<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.EstadosDisponibles.Any())
{
    <h2>Cambiar estado</h2>
    <form method="post" asp-page-handler="CambiarEstado">
        <input type="hidden" name="id" value="@Model.Incidente.Id" />
        <div class="form-floating">
            <select asp-for="NuevoEstado" class="form-select">
                <option value="">-- Selecciona el nuevo estado --</option>
                @foreach (var estado in Model.EstadosDisponibles)
                {
                    <option value="@estado">@AvisosIncidente.Estado(estado)</option>
                }
            </select>
            <label asp-for="NuevoEstado">Nuevo estado</label>
        </div>
        <div class="form-floating">
            <textarea asp-for="NuevoComentario" class="form-control" rows="2"></textarea>
            <label asp-for="NuevoComentario">Comentario (opcional)</label>
        </div>
        <button type="submit" class="btn">Actualizar estado</button>
    </form>
}
else
{
    <p><em>Este incidente está cerrado, no admite más cambios de estado.</em></p>
}

<h2>Agregar comentario</h2>
<form method="post" asp-page-handler="Comentario">
    <input type="hidden" name="id" value="@Model.Incidente.Id" />
    <div class="form-floating">
        <textarea name="NuevoComentario" class="form-control" rows="2"></textarea>
        <label>Comentario</label>
    </div>
    <button type="submit" class="boton boton-secundario">Comentar</button>
</form>

<h2>Historial</h2>
<table class="tabla-incidentes">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Cambio</th>
            <th>Comentario</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model.Incidente.Historial.OrderByDescending(h => h.Fecha))
        {
            <tr>
                <td>@h.Fecha.ToLocalTime().ToString("g")</td>
                <td>
                    @if (h.EstadoAnterior == h.EstadoNuevo)
                    {
                        <span>Comentario</span>
                    }
                    else
                    {
                        <span>@AvisosIncidente.Estado(h.EstadoAnterior) &rarr; @AvisosIncidente.Estado(h.EstadoNuevo)</span>
                    }
                </td>
                <td>@h.Comentario</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}