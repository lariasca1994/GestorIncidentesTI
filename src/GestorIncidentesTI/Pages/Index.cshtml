@page
@{
    ViewData["Title"] = "Inicio";
    // Portada pública: no toca la base de datos (a propósito, por la cuota
    // de Azure SQL; el monitor de estado la consulta seguido).
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <p class="tarjeta-paso">Sesión iniciada</p>
    <h1 class="tarjeta-titulo">Hola de nuevo</h1>
    <p class="tarjeta-subtitulo">Revisa el estado de tus incidentes y sus SLA.</p>
    <a class="boton-primario" asp-page="/Dashboard">Ir al Dashboard</a>
    <a class="boton-secundario" asp-page="/Incidentes/Index">Ver incidentes</a>
}
else
{
    <p class="tarjeta-paso">Bienvenido</p>
    <h1 class="tarjeta-titulo">Gestor de Incidentes TI</h1>
    <p class="tarjeta-subtitulo">
        Registra incidentes de soporte, mide su SLA por prioridad y deja que el
        escalamiento N1 → N2 → N3 ocurra solo cuando el tiempo se agota.
    </p>
    <a class="boton-primario" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
    <a class="boton-secundario" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
}

<ul class="insignias-acceso">
    <li>ASP.NET Core</li>
    <li>C#</li>
    <li>Entity Framework Core</li>
    <li>SQL Server</li>
</ul>
