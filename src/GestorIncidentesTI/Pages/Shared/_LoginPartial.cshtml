@using Microsoft.AspNetCore.Identity
@using GestorIncidentesTI.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <span style="color: var(--text-muted); font-size: 0.9rem;">
        Hola, @UserManager.GetUserName(User)
    </span>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post" style="display:inline;">
        <button type="submit" style="background:none; border:none; color: var(--primary); cursor:pointer; font: inherit; padding:0;">
            Cerrar sesión
        </button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Register">Registrarme</a>
    <a asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
}
