<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - Gestor de Incidentes TI</title>
    <link rel="icon" href="~/iconos/icono.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="~/iconos/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F2A26" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            var guardado = localStorage.getItem("tema") || "dark";
            document.documentElement.setAttribute("data-theme", guardado);
        })();
    </script>
</head>
<body>
    <header>
        <nav>
            <a class="nav-marca" asp-page="/Index"><img src="~/iconos/icono.svg" alt="" /><strong>Gestor de Incidentes TI</strong></a>
            <a asp-page="/Index">Inicio</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Dashboard">Dashboard</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Admin/Proyectos/Index">Proyectos</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Incidentes/Index">Incidentes</a>
            }
            <partial name="_LoginPartial" />
            <button class="theme-toggle" id="toggleTema" title="Cambiar tema" type="button">🌓</button>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.getElementById("toggleTema").addEventListener("click", function () {
            var actual = document.documentElement.getAttribute("data-theme") || "dark";
            var nuevo = actual === "dark" ? "light" : "dark";
            document.documentElement.setAttribute("data-theme", nuevo);
            localStorage.setItem("tema", nuevo);
        });
    </script>
</body>
</html>
