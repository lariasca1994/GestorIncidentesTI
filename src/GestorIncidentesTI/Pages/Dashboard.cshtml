@page "/dashboard"
@model GestorIncidentesTI.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard de Incidentes</h1>

<section class="metricas">
    <div class="tarjeta">
        <span class="numero">@Model.TotalAbiertos</span>
        <span class="etiqueta">Incidentes abiertos</span>
    </div>
    <div class="tarjeta">
        <span class="numero">@Model.TotalConSlaIncumplido</span>
        <span class="etiqueta">SLA incumplido</span>
    </div>
    <div class="tarjeta">
        <span class="numero">@Model.PorcentajeCumplimiento%</span>
        <span class="etiqueta">Cumplimiento de SLA</span>
    </div>
</section>

<table class="tabla-incidentes">
    <thead>
        <tr>
            <th>Título</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Nivel</th>
            <th>SLA</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var incidente in Model.IncidentesAbiertos)
        {
            <tr class="fila-@incidente.NivelRiesgo">
                <td>@incidente.Titulo</td>
                <td><span class="badge badge-@incidente.Prioridad.ToString().ToLowerInvariant()">@incidente.Prioridad</span></td>
                <td><span class="badge badge-@incidente.Estado.ToString().ToLowerInvariant()">@incidente.Estado</span></td>
                <td>@incidente.NivelActual</td>
                <td><span class="badge badge-@incidente.NivelRiesgo">@incidente.TiempoSlaTexto</span></td>
            </tr>
        }
    </tbody>
</table>