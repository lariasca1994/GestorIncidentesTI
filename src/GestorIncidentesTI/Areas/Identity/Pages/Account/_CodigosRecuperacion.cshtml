@model IReadOnlyList<string>
@* Códigos de recuperación recién generados: se muestran una sola vez. *@
@if (Model.Count > 0)
{
    <div class="codigos-recuperacion" role="region" aria-label="Códigos de recuperación nuevos">
        <p class="codigos-titulo">Tus códigos de recuperación nuevos</p>
        <p class="codigos-ayuda">
            Los anteriores ya no sirven. Guárdalos en un lugar seguro: no se vuelven a mostrar. Cada uno
            sirve para un ingreso si no tienes a mano tu app autenticadora.
        </p>
        <ul>
            @foreach (var codigo in Model)
            {
                <li><code>@codigo</code></li>
            }
        </ul>
    </div>
}
