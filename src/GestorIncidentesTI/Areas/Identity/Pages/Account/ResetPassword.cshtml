@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Contraseña nueva";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Acceso</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>

@if (Model.Cambiada)
{
    <p class="mfa-aviso" role="status">
        Listo: tu contraseña cambió y se cerraron las sesiones abiertas. Al ingresar te pediremos,
        como siempre, el código de tu verificación en dos pasos.
    </p>
    <partial name="_CodigosRecuperacion" model="Model.CodigosRecuperacion" />
    <div class="enlaces-acceso">
        <a asp-page="./Login">Iniciar sesión</a>
    </div>
}
else if (!Model.EnlaceValido)
{
    <p class="tarjeta-subtitulo">Este enlace venció o ya se usó. Pide uno nuevo.</p>
    <div class="enlaces-acceso">
        <a asp-page="./ForgotPassword">Pedir un enlace nuevo</a>
        <a asp-page="./Login">Volver al ingreso</a>
    </div>
}
else
{
    <p class="tarjeta-subtitulo">
        Escribe tu contraseña nueva: al menos 6 caracteres, con una mayúscula, una minúscula y un número.
    </p>

    <form method="post" asp-route-usuario="@Model.Usuario" asp-route-codigo="@Model.Codigo">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating">
            <label asp-for="Password" class="form-label">Contraseña nueva</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" autofocus />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit">Guardar contraseña</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
