@page
@model LockoutModel
@{
    ViewData["Title"] = "Cuenta bloqueada";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Acceso</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>
<p class="tarjeta-subtitulo">
    Por seguridad, la cuenta quedó bloqueada un tiempo tras varios intentos fallidos. Espera unos
    minutos e intenta de nuevo, o crea una contraseña nueva.
</p>

<div class="enlaces-acceso">
    <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
    <a asp-page="./Login">Volver al ingreso</a>
</div>
