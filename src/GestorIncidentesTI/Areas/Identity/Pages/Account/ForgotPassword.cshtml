@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Acceso</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>

@if (Model.Enviado)
{
    <p class="mfa-aviso" role="status">
        Si el correo corresponde a una cuenta, te enviamos un enlace para crear una contraseña nueva.
        Vence en 30 minutos y sirve una sola vez. Revisa también la carpeta de spam.
    </p>
}
else
{
    <p class="tarjeta-subtitulo">Escribe el correo de tu cuenta y te enviaremos un enlace para crear una contraseña nueva.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-floating">
            <label asp-for="Email" class="form-label">Correo</label>
            <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@empresa.com" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit">Enviar enlace</button>
    </form>
}

<div class="enlaces-acceso">
    <a asp-page="./Login">Volver al ingreso</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
