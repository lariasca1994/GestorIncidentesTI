@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de recuperación";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Segundo paso</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>
<p class="tarjeta-subtitulo">Escribe uno de tus códigos de recuperación. Cada código sirve una sola vez.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <label for="codigo" class="form-label">Código de recuperación</label>
        <input id="codigo" name="codigo" class="form-control" autocomplete="off" maxlength="20" required autofocus />
    </div>
    <button type="submit">Ingresar</button>
</form>

<div class="enlaces-acceso">
    <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl">Volver a la verificación</a>
    <a asp-page="./PerdiAutenticador" asp-route-returnUrl="@Model.ReturnUrl">Perdí mi autenticador</a>
</div>
