@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Acceso</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>
<p class="tarjeta-subtitulo">Ingresa con tu cuenta para ver y gestionar los incidentes de tu proyecto.</p>

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <label asp-for="Input.Email" class="form-label">Correo</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@empresa.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.Password" class="form-label">Contraseña</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <label class="recordarme">
        <input class="form-check-input" asp-for="Input.RememberMe" />
        Recordarme en este equipo
    </label>
    <button id="login-submit" type="submit">Ingresar</button>
</form>

<div class="enlaces-acceso">
    <a id="forgot-password" asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Crear una cuenta nueva</a>
    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar el correo de confirmación</a>
</div>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @foreach (var provider in Model.ExternalLogins!)
        {
            <button type="submit" class="btn btn-secondary" name="provider" value="@provider.Name" title="Ingresar con tu cuenta de @provider.DisplayName">@provider.DisplayName</button>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
