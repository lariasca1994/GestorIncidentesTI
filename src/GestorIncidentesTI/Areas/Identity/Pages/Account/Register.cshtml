@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Cuenta nueva</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>
<p class="tarjeta-subtitulo">Elige el proyecto al que perteneces: verás y gestionarás solo sus incidentes.</p>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <label asp-for="Input.Email">Correo</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@empresa.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.ProyectoId">Proyecto</label>
        <select asp-for="Input.ProyectoId" asp-items="Model.ProyectosDisponibles" class="form-control">
            <option value="">-- Selecciona un proyecto --</option>
        </select>
        <span asp-validation-for="Input.ProyectoId" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.Password">Contraseña</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button id="registerSubmit" type="submit">Crear cuenta</button>
</form>

<div class="enlaces-acceso">
    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">¿Ya tienes cuenta? Inicia sesión</a>
</div>

@if ((Model.ExternalLogins?.Count ?? 0) > 0)
{
    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @foreach (var provider in Model.ExternalLogins!)
        {
            <button type="submit" class="btn btn-secondary" name="provider" value="@provider.Name" title="Registrarte con tu cuenta de @provider.DisplayName">@provider.DisplayName</button>
        }
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
