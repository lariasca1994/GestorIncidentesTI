@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "/Pages/Shared/_LayoutAcceso.cshtml";
}

<p class="tarjeta-paso">Tu cuenta</p>
<h1 class="tarjeta-titulo">@ViewData["Title"]</h1>
<p class="tarjeta-subtitulo">
    Al guardarla se cierran las sesiones abiertas en otros equipos y recibes códigos de recuperación
    nuevos (los anteriores dejan de servir).
</p>

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating">
        <label asp-for="Input.OldPassword" class="form-label">Contraseña actual</label>
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.NewPassword" class="form-label">Contraseña nueva</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="form-floating">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña nueva</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit">Guardar contraseña</button>
</form>

<div class="enlaces-acceso">
    <a asp-page="/Account/Seguridad">Volver a Seguridad</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
